{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "experimentalServices": {
    "web": {
      "entrypoint": "web",
      "framework": "nextjs",
      "routePrefix": "/"
    },
    "api": {
      "entrypoint": "src/api/app.py",
      "framework": "fastapi",
      "routePrefix": "/api",
      "maxDuration": 60,
      "excludeFiles": [
        "tests/**",
        "fixtures/**",
        "docs/**",
        "web/**",
        ".obsidian/**",
        ".gamefeel/**",
        "gamefeel/**",
        "[0-9][0-9]-*.md",
        "AGENTS.md",
        "CLAUDE.md",
        "ENGINEERING.md",
        "Game-Naming-And-Branding.md",
        "Love-Island-Reference.md"
      ]
    }
  }
}
